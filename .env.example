DATABASE_URL="postgresql://restaurant:restaurant@localhost:5432/restaurant_ops?schema=public"
AUTH_SECRET="replace-me-with-a-random-string-min-32-chars-long"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_NAME="God's Chai Operations"

# ── Email invoices (see docs/EMAIL-INVOICES.md) ────────────────────────────
# All six are needed. Nothing else in the app depends on them: without them the
# Settings > Integrations card just says what is missing.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match the redirect URI registered in Google Cloud EXACTLY (www or not).
GOOGLE_REDIRECT_URI="https://www.example.com/api/mail/google/callback"
# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts the stored Gmail permission. Do not change it once a mailbox is
# connected, or the stored permission can no longer be read (reconnect fixes it).
MAIL_TOKEN_KEY=""
ANTHROPIC_API_KEY=""
# Random string:  openssl rand -hex 32   (the same value goes in GitHub Actions secrets)
CRON_SECRET=""
# Optional. Both default to claude-opus-5-5. The first stage reads every candidate
# email and is where the cost is — a cheaper model there cuts it sharply.
# INVOICE_TRIAGE_MODEL="claude-haiku-5-5"
# INVOICE_EXTRACT_MODEL="claude-opus-5-5"
