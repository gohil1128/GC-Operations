generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────────

// Ordered most to least privileged. Nothing should test `role === "OWNER"` to
// decide what a non-owner may do — with three roles that silently grants a
// STAFF member everything a MANAGER has. Go through src/lib/permissions.ts.
enum Role {
  OWNER
  MANAGER
  STAFF
}

enum LocationKind {
  STORE
  EVENT
}

enum POStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum CountType {
  OPEN
  MID
  CLOSE
  WEEKLY
}

enum MovementType {
  PURCHASE
  USAGE
  WASTE
  ADJUSTMENT
  COUNT_RECONCILE
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  MISSED
}

enum SalesSource {
  MANUAL
  CSV
  POS
}

enum ExpenseCategory {
  RENT
  UTILITIES
  MARKETING
  CONTRACTOR
  INSURANCE
  EQUIPMENT
  REPAIRS
  ADMIN
  OTHER
}

// ──────────────────────────────────────────────────────────────────────────────
// Tenant
// ──────────────────────────────────────────────────────────────────────────────

model Business {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/New_York")
  // Invoice categories this business books below the gross-profit line
  // rather than against cost of goods. Anything not listed stays in
  // COGS — see src/modules/reports/cost-classes.ts for why.
  opexInvoiceCategories String[] @default(["Rent / Venue", "Marketing", "Equipment & Smallwares", "Repairs & Maintenance", "Cleaning"])
  currency  String   @default("CAD")
  laborTargetPct Int @default(30) // labor cost target as percent
  foodTargetPct  Int @default(32)
  // One PIN guards every protected section; `lockedSections` says which ones
  // are behind it. Null hash = nothing is locked, whatever the list says.
  sectionPinHash String?  // bcrypt hash of 4-digit PIN
  lockedSections String[] @default([])  // "RECIPES" | "REPORTS" | "EVENTS"
  // Overview cards this business has turned off. Stored as the HIDDEN ones so
  // a card added later shows up for everybody instead of being invisible until
  // each business goes and enables it. See src/modules/dashboard/cards.ts.
  hiddenOverviewCards String[] @default([])
  ebitdaMultiplier  Float @default(4.0) // applied when EBITDA > 0
  revenueMultiplier Float @default(1.5) // fallback when EBITDA <= 0
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations       Location[]
  users           User[]
  suppliers       Supplier[]
  ingredients     Ingredient[]
  recipes         Recipe[]
  employees       Employee[]
  reportSnapshots ReportSnapshot[]
  auditLogs       AuditLog[]
  events          Event[]
  expenses        Expense[]
  vendors         Vendor[]
}

model Location {
  id         String       @id @default(cuid())
  businessId String
  name       String
  kind       LocationKind @default(STORE)
  address    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users            UserLocation[]
  inventoryCounts  InventoryCount[]
  movements        InventoryMovement[]
  purchaseOrders   PurchaseOrder[]
  shifts           Shift[]
  dailySales       DailySales[]
  cashCloses       CashClose[]
  deposits         Deposit[]
  cashPayouts      CashPayout[]
  itemRecipeLinks  ItemRecipeLink[]
  reportSnapshots  ReportSnapshot[]
  invoices         Invoice[]
  expenses         Expense[]
  salesItems       SalesItem[]
  capitalAssets    CapitalAsset[]

  @@index([businessId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Auth
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MANAGER)
  businessId   String
  // True while the account is still on a password somebody else chose — set
  // when an owner creates the account or resets it, cleared the moment the
  // person picks their own. Everything behind the app refuses to load until
  // then, so a handed-over password can only ever be used once.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locations        UserLocation[]
  inventoryCounts  InventoryCount[]
  purchaseOrders   PurchaseOrder[]
  cashCloses       CashClose[]
  verifiedCloses   CashClose[]      @relation("CashCloseVerifier")
  auditLogs        AuditLog[]
  invoices         Invoice[]
  expenses         Expense[]
  capitalAssets    CapitalAsset[]
  resetTokens      PasswordResetToken[]

  @@index([businessId])
}

// A single-use, expiring password reset. Only the hash of the token is stored,
// for the same reason passwords are hashed: read access to this table must not
// be enough to take over an account. The raw token exists only in the link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserLocation {
  userId     String
  locationId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([locationId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Suppliers & Ingredients
// ──────────────────────────────────────────────────────────────────────────────

model Supplier {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  email        String?
  phone        String?
  terms        String?
  leadTimeDays Int      @default(2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredients    Ingredient[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]

  @@index([businessId])
}

model Ingredient {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  sku            String?
  category       String?
  unit           String   // primary inventory unit (e.g. "lb", "ea", "oz", "gal")
  parLevel       Float    @default(0)
  reorderPoint   Float    @default(0)
  reorderQty     Float    @default(0)
  onHand         Float    @default(0)
  lastCostCents  Int      @default(0)
  avgCostCents   Int      @default(0)
  supplierId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  conversions      UnitConversion[]
  recipeIngredients RecipeIngredient[]
  movements        InventoryMovement[]
  countLines       InventoryCountLine[]
  poItems          PurchaseOrderItem[]
  invoiceItems     InvoiceItem[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([supplierId])
}

model UnitConversion {
  id           String @id @default(cuid())
  ingredientId String
  fromUnit     String
  toUnit       String
  factor       Float

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Recipes
// ──────────────────────────────────────────────────────────────────────────────

model Recipe {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  category       String?
  menuPriceCents Int      @default(0)
  yieldQty       Float    @default(1)
  yieldUnit      String   @default("ea")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  itemLinks   ItemRecipeLink[]

  @@unique([businessId, name])
  @@index([businessId])
}

// Which recipe a sold item is made from.
//
// Square sends an item name and nothing else, so there is no way to cost what
// sold without somebody saying "Masala Chai (12oz) is this recipe" once. That
// mapping keys on the NAME rather than living on the SalesItem rows: a new
// import writes fresh rows, and a per-row link would be lost every time the
// operator uploaded a CSV — the mapping has to outlive the data it describes.
model ItemRecipeLink {
  id         String   @id @default(cuid())
  locationId String
  itemName   String
  recipeId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([locationId, itemName])
  @@index([recipeId])
}

model RecipeIngredient {
  id           String @id @default(cuid())
  recipeId     String
  ingredientId String
  qty          Float
  unit         String

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Inventory counts & movements
// ──────────────────────────────────────────────────────────────────────────────

model InventoryCount {
  id            String    @id @default(cuid())
  locationId    String
  type          CountType @default(WEEKLY)
  countedAt     DateTime  @default(now())
  countedById   String
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  location  Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  countedBy User                  @relation(fields: [countedById], references: [id])
  lines     InventoryCountLine[]

  @@index([locationId, countedAt])
}

model InventoryCountLine {
  id                 String @id @default(cuid())
  countId            String
  ingredientId       String
  qtyCounted         Float
  unit               String
  theoreticalQty     Float
  varianceQty        Float
  varianceCostCents  Int

  count      InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  ingredient Ingredient     @relation(fields: [ingredientId], references: [id])

  @@index([countId])
  @@index([ingredientId])
}

model InventoryMovement {
  id            String       @id @default(cuid())
  locationId    String
  ingredientId  String
  type          MovementType
  qty           Float        // positive: in; negative: out
  unit          String
  unitCostCents Int          @default(0)
  occurredAt    DateTime     @default(now())
  sourceType    String?      // 'PO' | 'SALE' | 'WASTE' | 'ADJUST' | 'COUNT'
  sourceId      String?
  note          String?
  createdAt     DateTime     @default(now())

  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([ingredientId, occurredAt])
  @@index([locationId, occurredAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Purchasing
// ──────────────────────────────────────────────────────────────────────────────

model PurchaseOrder {
  id            String    @id @default(cuid())
  locationId    String
  supplierId    String
  status        POStatus  @default(DRAFT)
  orderedAt     DateTime  @default(now())
  expectedAt    DateTime?
  receivedAt    DateTime?
  subtotalCents Int       @default(0)
  totalCents    Int       @default(0)
  notes         String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  location  Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]
  invoices  Invoice[]

  @@index([locationId, status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id             String @id @default(cuid())
  poId           String
  ingredientId   String
  qtyOrdered     Float
  qtyReceived    Float  @default(0)
  unit           String
  unitCostCents  Int
  lineTotalCents Int

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])

  @@index([poId])
  @@index([ingredientId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Labor
// ──────────────────────────────────────────────────────────────────────────────

model Employee {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  email           String?
  position        String
  hourlyRateCents Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shifts   Shift[]

  @@index([businessId])
}

model Shift {
  id               String      @id @default(cuid())
  locationId       String
  employeeId       String
  position         String
  start            DateTime
  end              DateTime
  scheduledMinutes Int
  status           ShiftStatus @default(SCHEDULED)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  location  Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employee  Employee    @relation(fields: [employeeId], references: [id])
  timeEntry TimeEntry?

  @@index([locationId, start])
  @@index([employeeId, start])
}

model TimeEntry {
  id             String   @id @default(cuid())
  shiftId        String   @unique
  clockIn        DateTime
  clockOut       DateTime
  actualMinutes  Int
  breakMinutes   Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────────────────────────────────────
// Sales & Cash
// ──────────────────────────────────────────────────────────────────────────────

model DailySales {
  id            String      @id @default(cuid())
  locationId    String
  businessDate  DateTime    // date only, midnight in business tz
  netSalesCents Int
  taxCents      Int         @default(0)
  tipsCents     Int         @default(0)
  guestCount    Int         @default(0)
  source        SalesSource @default(MANUAL)
  eventId       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  event    Event?   @relation(fields: [eventId], references: [id])

  @@unique([locationId, businessDate])
  @@index([locationId, businessDate])
  @@index([eventId])
}

model CashClose {
  id              String   @id @default(cuid())
  locationId      String
  businessDate    DateTime
  openingCents    Int
  closingCents    Int
  cashCents       Int      @default(0)   // cash portion of closing
  creditCents     Int      @default(0)   // credit/debit card portion
  safeCountCents  Int      @default(0)
  depositCents    Int      @default(0)
  paidInCents     Int      @default(0)
  paidOutCents    Int      @default(0)
  expectedCents   Int      // expected closing based on sales + opening
  overShortCents  Int      // closing + deposit - opening - expected
  weather         String?
  specialEvents   String?
  verifiedById    String?
  verifiedAt      DateTime?
  eventId         String?
  checklistJson   Json?
  notes           String?
  closedById      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  closedBy   User      @relation(fields: [closedById], references: [id])
  verifiedBy User?     @relation("CashCloseVerifier", fields: [verifiedById], references: [id])
  event      Event?    @relation(fields: [eventId], references: [id])

  @@unique([locationId, businessDate])
  @@index([locationId, businessDate])
  @@index([eventId])
}

model Deposit {
  id           String   @id @default(cuid())
  locationId   String
  businessDate DateTime
  amountCents  Int
  sequence     Int?
  bagCode      String?
  preparedBy   String?
  notes        String?
  reference    String?
  createdAt    DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, businessDate])
}

enum PayoutKind {
  REIMBURSEMENT // someone bought something with their own money and took the cash back
  SUPPLIER // paid a supplier in cash straight out of the till
  OTHER
}

// Cash legitimately taken out of the drawer during the day, itemised.
//
// The counterpart to Deposit, and the reason CashClose.paidOutCents stops
// being a number somebody types: a payout has to say what it was for and who
// took it, or a drawer that is $40 light is indistinguishable from a mistake.
//
// Carries no User foreign key on purpose. `paidTo` is free text because the
// person reimbursed is often not somebody with an account — and because every
// required FK onto User is one more thing blocking that account from ever
// being deleted.
model CashPayout {
  id           String     @id @default(cuid())
  locationId   String
  businessDate DateTime
  amountCents  Int
  kind         PayoutKind @default(REIMBURSEMENT)
  reason       String // what the money was spent on
  paidTo       String? // who took the cash
  reference    String? // receipt or invoice number, if there is one
  createdAt    DateTime   @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, businessDate])
}

model SalesItem {
  id            String   @id @default(cuid())
  locationId    String
  businessDate  DateTime
  itemName      String
  category      String?
  qty           Float
  netSalesCents Int
  taxCents      Int      @default(0)
  txCount       Int      @default(0)
  eventId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  event    Event?   @relation(fields: [eventId], references: [id])

  @@unique([locationId, businessDate, itemName])
  @@index([locationId, businessDate])
  @@index([eventId])
  @@index([itemName])
}

// ──────────────────────────────────────────────────────────────────────────────
// Events (promo / pop-up tags for analysis filters)
// ──────────────────────────────────────────────────────────────────────────────

model Event {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  startDate    DateTime
  endDate      DateTime
  color        String?  // hex like #f97316
  notes        String?
  isActive     Boolean  @default(true)
  // Booth / vendor / entry fee paid to participate. Counts as an event-scoped
  // operating expense in finance.
  feeCents     Int      @default(0)
  feeNote      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dailySales  DailySales[]
  cashCloses  CashClose[]
  expenses    Expense[]
  salesItems  SalesItem[]
  invoices    Invoice[]
  capitalAssets CapitalAsset[]

  @@index([businessId, startDate])
}

// ──────────────────────────────────────────────────────────────────────────────
// Reports & Audit
// ──────────────────────────────────────────────────────────────────────────────

model ReportSnapshot {
  id          String   @id @default(cuid())
  businessId  String
  locationId  String?
  kind        String
  periodStart DateTime
  periodEnd   DateTime
  dataJson    Json
  createdAt   DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])

  @@index([businessId, kind, periodStart])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  // Nullable, unlike every other actor: this is a pure historical trail with
  // no viewer UI reading it, so the row is worth keeping after the actor is
  // gone, but the FK must not be what blocks deleting them. Every OTHER
  // user-created record (invoices, expenses, purchase orders...) stays
  // required and gets reassigned to a successor instead — those matter for
  // real reporting and should never point at nobody.
  userId     String?
  action     String
  entityType String
  entityId   String?
  diffJson   Json?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Invoices (supplier billing — supports create-from-PO and standalone)
// ──────────────────────────────────────────────────────────────────────────────

model Invoice {
  id            String    @id @default(cuid())
  locationId    String
  supplierId    String
  poId          String?
  eventId       String?
  // Shared cost covering every event (bulk cups, tent, etc.). Mutually
  // exclusive with eventId. Split evenly across events in per-event P&L;
  // counted once in overall totals.
  appliesToAllEvents Boolean @default(false)
  // What the bill was for (Ingredients & Supplies, Packaging, Equipment...).
  // Free-text so custom values already saved never get clobbered by preset
  // changes — see src/lib/gc-categories.ts INVOICE_CATEGORIES.
  category      String?
  invoiceNumber String
  invoiceDate   DateTime
  dateReceived  DateTime
  subtotalCents Int       @default(0)
  gstCents      Int       @default(0)
  pstCents      Int       @default(0)
  shippingCents Int       @default(0)
  rebateCents   Int       @default(0)
  totalCents    Int       @default(0)
  internalMemo  String?
  // Photo of the paper invoice, stored as a compressed JPEG data URL
  // (client-side downscaled; ~200-500 KB). Null when no photo attached.
  imageDataUrl  String?
  closedAt      DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  location  Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  po        PurchaseOrder? @relation(fields: [poId], references: [id])
  event     Event?         @relation(fields: [eventId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  items     InvoiceItem[]

  @@unique([supplierId, invoiceNumber])
  @@index([locationId, invoiceDate])
  @@index([supplierId])
  @@index([eventId])
}

model InvoiceItem {
  id             String @id @default(cuid())
  invoiceId      String
  ingredientId   String
  qty            Float
  unit           String
  unitCostCents  Int
  lineTotalCents Int

  invoice    Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([invoiceId])
  @@index([ingredientId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Operating expenses (non-COGS) — rent, utilities, marketing, etc.
// COGS is captured separately via Invoice/PurchaseOrder line items.
// ──────────────────────────────────────────────────────────────────────────────

model Expense {
  id           String          @id @default(cuid())
  businessId   String
  locationId   String
  eventId      String?
  vendorId     String?
  category     ExpenseCategory
  businessDate DateTime
  amountCents  Int
  description  String?
  isIncentive  Boolean         @default(false)
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  event     Event?   @relation(fields: [eventId], references: [id])
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([businessId, businessDate])
  @@index([locationId, businessDate])
  @@index([eventId])
  @@index([vendorId])
  @@index([category])
}

// ──────────────────────────────────────────────────────────────────────────────
// Vendors / Contractors — recurring service providers
// (graphic designers, accountants, freelancers, agencies, etc.)
// ──────────────────────────────────────────────────────────────────────────────

model Vendor {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  role            String?    // e.g. "Graphic Designer", "Accountant"
  country         String?    // free-text country for tax/jurisdiction context
  monthlyFeeCents Int        @default(0)
  currency        String     @default("CAD")
  defaultCategory ExpenseCategory @default(CONTRACTOR)
  isFlatFee       Boolean    @default(true)  // true = no tax withholding
  notes           String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([businessId])
}

// Capital / fixed asset — high-cost equipment kept separate from regular
// operating expenses because the financial treatment is different (sunk
// purchase cost + ongoing depreciation, not a one-shot opex hit). Examples:
// hot holding unit, tea dispenser, refrigerator, espresso machine.
enum CapitalStatus {
  IN_SERVICE
  SOLD
  WRITTEN_OFF
}

model CapitalAsset {
  id                String        @id @default(cuid())
  locationId        String
  name              String
  category          String?       // e.g. "Beverage equipment", "Refrigeration"
  vendor            String?
  purchaseDate      DateTime
  purchasePriceCents Int
  // Months of useful life for straight-line depreciation. Null = treat as
  // non-depreciating (the operator just tracks total invested).
  usefulLifeMonths  Int?
  salvageValueCents Int           @default(0)
  status            CapitalStatus @default(IN_SERVICE)
  notes             String?
  eventId           String?
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  event     Event?   @relation(fields: [eventId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([locationId])
  @@index([eventId])
}

// Login throttling. Serverless means per-instance counters are unreliable, so
// attempts are tracked in the database. One row per key, where a key is either
// "email:<address>" or "ip:<addr>" — email catches an attack on one account,
// IP catches spraying across many.
model LoginAttempt {
  id          String    @id @default(cuid())
  key         String    @unique
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}
